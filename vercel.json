{
  "name": "refineai",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "regions": ["iad1"],
  "functions": {
    "app/api/training-pipeline/process/route.ts": {
      "maxDuration": 300
    },
    "app/api/training-pipeline/trigger-check/route.ts": {
      "maxDuration": 300
    },
    "app/api/inngest/route.ts": {
      "maxDuration": 300
    },
    "app/api/plan/route.ts": {
      "maxDuration": 120
    },
    "app/api/build/file/route.ts": {
      "maxDuration": 300
    },
    "app/api/projects/route.ts": {
      "maxDuration": 300
    },
    "app/api/chat/route.ts": {
      "maxDuration": 60
    },
    "app/api/preview/start/route.ts": {
      "maxDuration": 300
    }
  },
  "env": {
    "OPENAI_MODEL": "gpt-4o"
  },
  "crons": [
    {
      "path": "/api/model-config/rollout-check",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/training-pipeline/trigger-check",
      "schedule": "0 10 * * 0"
    },
    {
      "path": "/api/training-pipeline/process",
      "schedule": "0 11 * * *"
    }
  ],
  "github": {
    "autoAlias": true,
    "silent": true
  }
}
